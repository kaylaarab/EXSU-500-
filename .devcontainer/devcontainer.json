{
  "name": "EXSU 500 demo interface (private)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r 7_interface/requirements.txt",
  "postAttachCommand": "python -m streamlit run 7_interface/app.py --server.port 8501 --server.headless true",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Readmission demo", "onAutoForward": "openBrowser" }
  }
}
